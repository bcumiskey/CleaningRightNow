// Prisma schema for Cleaning Right Now Business Management Application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  businessName    String?
  businessPhone   String?
  businessEmail   String?
  businessAddress String?
  expensePercentage Float   @default(12.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  auditLogs       AuditLog[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// CORE MODELS
// ============================================================

model Property {
  id            String   @id @default(cuid())
  name          String   @unique
  address       String

  // Owner Info
  ownerName     String
  ownerEmail    String?
  ownerPhone    String?

  // Rates & Billing
  baseRate      Float
  billingType   String   @default("per_job") // "per_job" or "monthly"
  monthlyBillingDay Int?  // 1, 15, or last day (null if per_job)
  autoSendInvoice Boolean @default(false)

  // Calendar Integration
  calendarSource String?  // "turno", "google", "manual"
  icalUrl        String?  // For Turno iCal import

  // Access
  accessCode     String?
  accessNotes    String?

  // Relations
  jobs                Job[]
  invoices            Invoice[]
  linenRequirements   PropertyLinenRequirement[]
  linenInventory      PropertyLinenInventory[]
  notes               PropertyNote[]
  photos              PropertyPhoto[]
  standingInstructions PropertyInstruction[]
  replacementLogs     ReplacementLog[]
  laundryRecords      LaundryRecord[]
  propertySupplies    PropertySupply[]
  supplyUsage         SupplyUsage[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  role      String   @default("worker") // "admin" or "worker"
  isActive  Boolean  @default(true)

  // Auth (if implementing login)
  passwordHash String?

  // Relations
  jobAssignments JobAssignment[]
  notesAdded     PropertyNote[]  @relation("AddedBy")
  photosAdded    PropertyPhoto[] @relation("PhotoAddedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// JOBS & PAYMENTS
// ============================================================

model Job {
  id            String   @id @default(cuid())
  date          DateTime
  time          String?  // "9:00 AM"

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rate          Float
  expensePercent Float   @default(12) // Business expense percentage

  // Status
  completed     Boolean  @default(false)
  completedAt   DateTime?
  clientPaid    Boolean  @default(false)
  clientPaidAt  DateTime?
  teamPaid      Boolean  @default(false)
  teamPaidAt    DateTime?

  // Source tracking
  source        String   @default("manual") // "manual", "turno", "google"
  externalId    String?  // ID from external calendar

  // Relations
  assignments   JobAssignment[]
  invoiceItems  InvoiceLineItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JobAssignment {
  id            String   @id @default(cuid())
  jobId         String
  teamMemberId  String

  // Calculated when job is marked complete
  amountEarned  Float?

  job           Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  teamMember    TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([jobId, teamMemberId])
}

// ============================================================
// INVOICING
// ============================================================

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique // "INV-2026-001"

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])

  // Billing details
  type          String   // "per_job" or "monthly"
  billingPeriod String?  // "January 2026" for monthly

  invoiceDate   DateTime
  dueDate       DateTime?
  paymentTerms  String   @default("Due upon receipt")

  // Totals
  subtotal      Float
  discount      Float    @default(0)
  total         Float

  // Status
  status        String   @default("draft") // "draft", "sent", "paid", "overdue"
  sentAt        DateTime?
  paidAt        DateTime?

  // Custom content
  notes         String?  // Client-visible notes

  // Relations
  lineItems     InvoiceLineItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InvoiceLineItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Item details
  date          DateTime?
  description   String
  amount        Float

  // Link to job (if applicable)
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])

  // Type for categorization
  itemType      String   @default("service") // "service", "supplies", "expense", "misc", "custom"

  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
}

// Saved custom billing items for reuse
model CustomBillingItem {
  id          String   @id @default(cuid())
  name        String
  category    String   // "service", "supplies", "expense", "other"
  defaultAmount Float?

  createdAt   DateTime @default(now())
}

// ============================================================
// PROPERTY NOTES (Timeline)
// ============================================================

model PropertyNote {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Note content
  type        String   // "issue", "reminder", "owner_request", "info"
  content     String

  // Status
  status      String   @default("active") // "active", "resolved"
  resolvedAt  DateTime?

  // Tracking
  addedById   String
  addedBy     TeamMember @relation("AddedBy", fields: [addedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Standing instructions (persistent, not timeline)
model PropertyInstruction {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  instruction String
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
}

// Reference photos
model PropertyPhoto {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  room        String   // "Master Bedroom", "Kitchen", etc.
  caption     String?
  url         String   // Storage URL

  addedById   String
  addedBy     TeamMember @relation("PhotoAddedBy", fields: [addedById], references: [id])

  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
}

// ============================================================
// LINEN INVENTORY
// ============================================================

model LinenCategory {
  id        String      @id @default(cuid())
  name      String      @unique // "Sheets", "Bedding", "Pillows", "Towels"
  sortOrder Int         @default(0)
  items     LinenItem[]
}

model LinenItem {
  id          String   @id @default(cuid())
  name        String   // "King Top Sheet", "Bath Towel (Big)"
  code        String   @unique // "K-Top", "Bath-Big"
  unitCost    Float    @default(0)

  categoryId  String
  category    LinenCategory @relation(fields: [categoryId], references: [id])

  // Relations
  requirements   PropertyLinenRequirement[]
  inventory      PropertyLinenInventory[]
  vendorProducts VendorProduct[]
  replacements   ReplacementLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Per-flip requirements per property
model PropertyLinenRequirement {
  id          String   @id @default(cuid())
  propertyId  String
  linenItemId String

  perFlip     Int      @default(0) // Qty needed per turnover

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  linenItem   LinenItem @relation(fields: [linenItemId], references: [id], onDelete: Cascade)

  @@unique([propertyId, linenItemId])
}

// Current inventory on-hand
model PropertyLinenInventory {
  id          String   @id @default(cuid())
  propertyId  String
  linenItemId String

  onHand      Int      @default(0)

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  linenItem   LinenItem @relation(fields: [linenItemId], references: [id], onDelete: Cascade)

  updatedAt   DateTime @updatedAt

  @@unique([propertyId, linenItemId])
}

// ============================================================
// VENDORS & PURCHASING
// ============================================================

model Vendor {
  id        String          @id @default(cuid())
  name      String          @unique // "Palmetto", "Costco", "Amazon"
  website   String?
  notes     String?

  products  VendorProduct[]

  createdAt DateTime @default(now())
}

model VendorProduct {
  id          String   @id @default(cuid())
  vendorId    String
  linenItemId String

  productName String
  packSize    Int      @default(1)
  costPerPack Float
  link        String?
  notes       String?

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  linenItem   LinenItem @relation(fields: [linenItemId], references: [id], onDelete: Cascade)

  updatedAt   DateTime @updatedAt

  @@unique([vendorId, linenItemId])
}

// ============================================================
// REPLACEMENT & DAMAGE LOG
// ============================================================

model ReplacementLog {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())

  propertyId  String
  linenItemId String

  quantity    Int
  unitCost    Float
  totalCost   Float
  reason      String    // "Stained", "Torn", "Lost", "Worn out"

  replaced    Boolean   @default(false)
  replacedAt  DateTime?
  notes       String?

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  linenItem   LinenItem @relation(fields: [linenItemId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// ============================================================
// LAUNDRY TRACKING
// ============================================================

model LaundryProvider {
  id          String   @id @default(cuid())
  name        String   @unique
  contactInfo String?
  notes       String?

  records     LaundryRecord[]

  createdAt   DateTime @default(now())
}

model LaundryRecord {
  id            String   @id @default(cuid())
  providerId    String?
  propertyId    String

  dropOffDate   DateTime
  pickupDate    DateTime?

  status        String   @default("DROPPED_OFF") // "DROPPED_OFF", "READY_FOR_PICKUP", "PICKED_UP", "DELIVERED"
  cost          Float?
  items         String?
  notes         String?

  provider      LaundryProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// SUPPLIES TRACKING
// ============================================================

model Supply {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  unit              String   @default("unit") // "unit", "bottle", "box", etc.
  quantity          Float    @default(0)
  costPerUnit       Float    @default(0)
  lowStockThreshold Float    @default(5)
  category          String?

  restocks          SupplyRestock[]
  usage             SupplyUsage[]
  propertySupplies  PropertySupply[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PropertySupply {
  id          String   @id @default(cuid())
  propertyId  String
  supplyId    String

  currentStock Float   @default(0)

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  supply      Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  updatedAt   DateTime @updatedAt

  @@unique([propertyId, supplyId])
}

model SupplyRestock {
  id        String   @id @default(cuid())
  supplyId  String

  quantity  Float
  cost      Float    @default(0)
  notes     String?

  supply    Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model SupplyUsage {
  id          String   @id @default(cuid())
  propertyId  String
  supplyId    String
  jobId       String?

  quantity    Float

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  supply      Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// ============================================================
// SYSTEM
// ============================================================

// Audit log for tracking all changes
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // e.g., "CREATE", "UPDATE", "DELETE"
  entityType  String   // e.g., "Job", "Property", "TeamMember"
  entityId    String
  oldValues   Json?
  newValues   Json?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// Settings for app configuration
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
