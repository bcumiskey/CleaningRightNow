generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PROPERTY OWNERS
// ============================================================

model Owner {
  id          String    @id @default(cuid())
  name        String
  email       String?   @unique
  phone       String?
  notes       String?   // Internal notes about this owner
  isActive    Boolean   @default(true)

  // Default preferences (can be overridden per property)
  defaultBaseRate     Float?
  defaultBillingType  String?   // "per_job" | "monthly"
  preferredContactMethod String? // "email" | "phone" | "text"

  properties  Property[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================
// PROPERTIES
// ============================================================

model Property {
  id                  String   @id @default(cuid())
  name                String   @unique
  address             String
  isActive            Boolean  @default(true)

  // Owner (optional - can use legacy fields or Owner relation)
  ownerId             String?
  owner               Owner?   @relation(fields: [ownerId], references: [id])

  // Legacy owner fields (for backwards compatibility)
  ownerName           String
  ownerEmail          String?
  ownerPhone          String?

  // Rates & Billing
  baseRate            Float
  expensePercent      Float    @default(12)  // Percentage taken off top (default 12%)
  billingType         String   @default("per_job") // "per_job" | "monthly"
  billingFrequency    String   @default("per_job") // "per_job" | "weekly" | "biweekly" | "monthly"
  monthlyBillingDay   Int?     // 1, 15, or 31
  autoSendInvoice     Boolean  @default(false)

  // Keywords for matching calendar events to this property
  keywords            String?  // Comma-separated keywords, e.g., "beach house, smith rental"

  // Access Info (visible to workers)
  accessCode          String?
  accessNotes         String?

  // Bed Configuration (for linen reference)
  bedConfig           String?  // e.g., "3 King, 2 Queen, 1 Twin"

  // Main property image
  imageUrl            String?

  // Relations
  jobs                Job[]
  invoices            Invoice[]
  linenRequirements   PropertyLinenRequirement[]
  linenInventory      PropertyLinenInventory[]
  notes               PropertyNote[]
  photos              PropertyPhoto[]
  instructions        PropertyInstruction[]
  recurringSchedules  RecurringSchedule[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Property Notes - Timeline of issues/reminders/requests (incident documentation)
model PropertyNote {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        String    // "issue" | "damage" | "reminder" | "owner_request" | "info"
  title       String?   // Brief title/summary
  content     String    // Detailed description
  severity    String?   // "low" | "medium" | "high" (for issues/damage)

  status      String    @default("active") // "active" | "resolved" | "reported_to_owner"
  resolvedAt  DateTime?
  resolvedById String?
  resolvedBy   TeamMember? @relation("ResolvedNotes", fields: [resolvedById], references: [id])
  resolution   String?   // How was it resolved?

  // For damage tracking
  estimatedCost Float?   // Estimated repair/replacement cost
  ownerNotified Boolean  @default(false)
  ownerNotifiedAt DateTime?

  addedById   String
  addedBy     TeamMember @relation("AddedNotes", fields: [addedById], references: [id])

  // Photo evidence
  photos      NotePhoto[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Photos attached to notes (evidence of damage, issues, etc.)
model NotePhoto {
  id          String    @id @default(cuid())
  noteId      String
  note        PropertyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  url         String    // Vercel Blob URL
  caption     String?   // Description of what the photo shows
  sortOrder   Int       @default(0)

  createdAt   DateTime  @default(now())
}

// Standing Instructions - Permanent property info (organized by room)
model PropertyInstruction {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room          String   @default("General") // "General", "Kitchen", "Master Bedroom", etc.
  instruction   String
  linkedPhotoId String?  // Optional link to a PropertyPhoto
  linkedPhoto   PropertyPhoto? @relation(fields: [linkedPhotoId], references: [id], onDelete: SetNull)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}

// Reference Photos - How things should look (with detailed notes)
model PropertyPhoto {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        String   // "Master Bedroom", "Kitchen", etc.
  caption     String?  // Brief caption shown in gallery
  notes       String?  // Detailed notes shown when photo is clicked
  url         String
  addedById   String
  addedBy     TeamMember @relation(fields: [addedById], references: [id])
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  // Instructions that link to this photo
  linkedInstructions PropertyInstruction[]
}

// ============================================================
// TEAM MEMBERS
// ============================================================

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  email       String?   @unique
  phone       String?
  password    String?   // Hashed password for worker login
  role        String    @default("worker") // "admin" | "worker"
  isActive    Boolean   @default(true)

  // Hierarchy & Supervision
  rank        Int       @default(50)  // 1-100, higher = more senior. Admin owner should be 100
  canSupervise Boolean  @default(false) // Can this person supervise jobs?

  // Performance Metrics (calculated from ratings)
  avgRating       Float?   // Average performance rating (1-5)
  totalRatings    Int      @default(0) // Number of ratings received
  reliabilityScore Float?  // Attendance reliability (0-100)

  // Relations
  jobAssignments    JobAssignment[]
  notesAdded        PropertyNote[]      @relation("AddedNotes")
  notesResolved     PropertyNote[]      @relation("ResolvedNotes")
  photosAdded       PropertyPhoto[]
  pushSubscriptions PushSubscription[]

  // Job sessions (check-ins)
  jobSessions       JobSession[]
  supervisedSessions JobSession[]      @relation("SupervisedBy")
  ratingsGiven      PerformanceRating[] @relation("RatedBy")
  ratingsReceived   PerformanceRating[] @relation("RatedMember")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// JOBS & PAYMENTS
// ============================================================

model Job {
  id              String    @id @default(cuid())
  date            DateTime
  time            String?   // "9:00 AM"

  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rate            Float
  expensePercent  Float     @default(12)

  // Status Tracking
  completed       Boolean   @default(false)
  completedAt     DateTime?
  clientPaid      Boolean   @default(false)
  clientPaidAt    DateTime?
  teamPaid        Boolean   @default(false)
  teamPaidAt      DateTime?

  // Calendar Source
  source          String    @default("manual") // "manual" | "turno" | "google"
  externalId      String?

  // Relations
  assignments     JobAssignment[]
  invoiceItems    InvoiceLineItem[]
  sessions        JobSession[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model JobAssignment {
  id            String      @id @default(cuid())
  jobId         String
  teamMemberId  String
  amountEarned  Float?      // Calculated when job completed
  paidAt        DateTime?   // When this worker was paid

  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  teamMember    TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([jobId, teamMemberId])
}

// Recurring job schedules - auto-create jobs based on pattern
model RecurringSchedule {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name            String    // "Weekly Deep Clean", "Bi-weekly Turnover"
  isActive        Boolean   @default(true)

  // Schedule pattern
  frequency       String    // "daily" | "weekly" | "biweekly" | "monthly"
  dayOfWeek       Int?      // 0-6 for weekly (0=Sunday)
  dayOfMonth      Int?      // 1-31 for monthly
  time            String?   // "9:00 AM"

  // Job details
  rate            Float?    // Override property base rate if set
  expensePercent  Float     @default(12)

  // Auto-assign team
  autoAssignTeam  Boolean   @default(false)

  // How far ahead to generate jobs
  generateAheadDays Int     @default(30)

  // Track last generation
  lastGeneratedDate DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================
// INVOICING
// ============================================================

model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique // "INV-2026-001"

  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id])

  type            String    // "per_job" | "monthly"
  billingPeriod   String?   // "January 2026" for monthly

  invoiceDate     DateTime
  paymentTerms    String    @default("Due upon receipt")

  subtotal        Float
  discount        Float     @default(0)
  total           Float

  status          String    @default("draft") // "draft" | "sent" | "paid"
  sentAt          DateTime?
  paidAt          DateTime?

  notes           String?   // Client-visible notes

  lineItems       InvoiceLineItem[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model InvoiceLineItem {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  date        DateTime?
  description String
  amount      Float

  // Link to job (for sync)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id])

  itemType    String    @default("service") // "service" | "supplies" | "expense" | "misc" | "custom"
  sortOrder   Int       @default(0)

  createdAt   DateTime  @default(now())
}

// Saved custom billing items
model CustomBillingItem {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String   // "service" | "supplies" | "expense" | "other"
  defaultAmount Float?
  createdAt     DateTime @default(now())
}

// ============================================================
// LINEN INVENTORY
// ============================================================

model LinenCategory {
  id        String      @id @default(cuid())
  name      String      @unique
  sortOrder Int         @default(0)
  items     LinenItem[]
}

model LinenItem {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  unitCost    Float     @default(0)

  categoryId  String
  category    LinenCategory @relation(fields: [categoryId], references: [id])

  requirements   PropertyLinenRequirement[]
  inventory      PropertyLinenInventory[]
  vendorProducts VendorProduct[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Per-flip requirements (how many needed per turnover) + property-specific pricing
model PropertyLinenRequirement {
  id          String    @id @default(cuid())
  propertyId  String
  linenItemId String
  perFlip     Int       @default(0)
  unitCost    Float?    // Property-specific cost (can differ from master item)

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  linenItem   LinenItem @relation(fields: [linenItemId], references: [id], onDelete: Cascade)

  @@unique([propertyId, linenItemId])
}

// Current inventory on-hand
model PropertyLinenInventory {
  id          String    @id @default(cuid())
  propertyId  String
  linenItemId String
  onHand      Int       @default(0)

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  linenItem   LinenItem @relation(fields: [linenItemId], references: [id], onDelete: Cascade)

  updatedAt   DateTime  @updatedAt

  @@unique([propertyId, linenItemId])
}

model Vendor {
  id        String          @id @default(cuid())
  name      String          @unique
  website   String?
  notes     String?
  products  VendorProduct[]
  createdAt DateTime        @default(now())
}

model VendorProduct {
  id          String    @id @default(cuid())
  vendorId    String
  linenItemId String
  productName String
  packSize    Int       @default(1)
  costPerPack Float
  link        String?
  notes       String?

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  linenItem   LinenItem @relation(fields: [linenItemId], references: [id], onDelete: Cascade)

  updatedAt   DateTime  @updatedAt

  @@unique([vendorId, linenItemId])
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("admin") // "admin" | "worker"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================================
// COMPANY SETTINGS
// ============================================================

model CompanySettings {
  id              String    @id @default("default")
  companyName     String    @default("Cleaning Right Now")
  address         String?
  phone           String?
  email           String?
  website         String?
  logoUrl         String?   // URL to company logo
  invoiceFooter   String?   // Custom footer text for invoices
  invoiceTerms    String?   // Payment terms text
  updatedAt       DateTime  @updatedAt
}

// ============================================================
// PUSH NOTIFICATIONS
// ============================================================

model PushSubscription {
  id            String      @id @default(cuid())
  endpoint      String      @unique
  p256dh        String      // Public key for encryption
  auth          String      // Auth secret

  // Link to team member (worker) if applicable
  teamMemberId  String?
  teamMember    TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  // Link to admin user if applicable
  userId        String?

  // Device info
  userAgent     String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ============================================================
// CALENDAR SOURCES (Unified Sync)
// ============================================================

model CalendarSource {
  id            String    @id @default(cuid())
  name          String    // "Turno Master", "Google - Beach Properties", etc.
  type          String    // "turno" | "google" | "airbnb" | "vrbo" | "other"
  icalUrl       String    // The iCal feed URL
  isActive      Boolean   @default(true)

  // Sync tracking
  lastSyncAt    DateTime?
  lastSyncStatus String?  // "success" | "error"
  lastSyncError  String?  // Error message if failed
  lastSyncCount  Int?     // Number of events found

  // Property name patterns (optional - for filtering/matching)
  propertyPattern String? // Regex or keyword to match property names in events

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================================
// JOB SESSIONS (Check-in/out tracking)
// ============================================================

model JobSession {
  id              String    @id @default(cuid())
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  teamMemberId    String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id])

  // Check-in/out times
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  checkInMethod   String?   // "nfc" | "qr" | "manual"
  checkInLocation String?   // Lat,Long if available

  // Status
  status          String    @default("assigned") // "assigned" | "checked_in" | "completed" | "absent" | "late"
  isAbsent        Boolean   @default(false)
  absentReason    String?
  markedAbsentAt  DateTime?
  markedAbsentBy  String?   // TeamMember ID who marked them absent

  // Fill-in bonus for last-minute replacements
  isLastMinuteFillIn Boolean @default(false)
  fillInBonus        Float?  // Extra payment for stepping in

  // Supervisor for this session (highest ranked present team member)
  supervisorId    String?
  supervisor      TeamMember? @relation("SupervisedBy", fields: [supervisorId], references: [id])

  // Completion notes
  notes           String?   // Condition notes at completion
  completionPhotos String?  // JSON array of photo URLs

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Performance rating for this session
  rating          PerformanceRating?

  @@unique([jobId, teamMemberId])
}

// ============================================================
// PERFORMANCE RATINGS
// ============================================================

model PerformanceRating {
  id              String    @id @default(cuid())

  // The session being rated
  sessionId       String    @unique
  session         JobSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Who was rated
  teamMemberId    String
  teamMember      TeamMember @relation("RatedMember", fields: [teamMemberId], references: [id])

  // Who gave the rating (supervisor)
  ratedById       String
  ratedBy         TeamMember @relation("RatedBy", fields: [ratedById], references: [id])

  // Ratings (1-5 scale)
  qualityRating   Int       // Quality of work
  speedRating     Int       // Speed/efficiency
  attitudeRating  Int       // Professionalism/attitude
  overallRating   Float     // Calculated average

  // Optional feedback
  feedback        String?

  createdAt       DateTime  @default(now())
}

// ============================================================
// PROPERTY CHECK-IN TOKENS (NFC/QR)
// ============================================================

model PropertyCheckInToken {
  id          String    @id @default(cuid())
  propertyId  String
  token       String    @unique  // UUID for the check-in token
  isActive    Boolean   @default(true)

  // Token can expire and be rotated for security
  expiresAt   DateTime?
  lastUsedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
